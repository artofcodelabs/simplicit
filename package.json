{
  "name": "simplicit",
  "version": "0.5.2",
  "description": "A truly modest yet powerful JavaScript framework.",
  "type": "module",
  "main": "dist/simplicit.mjs",
  "module": "dist/simplicit.mjs",
  "exports": {
    ".": "./dist/simplicit.mjs"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js --fix",
    "lint-staged": "lint-staged",
    "build": "webpack --mode=production --config-node-env=production -c webpack.config.js --progress",
    "start": "node dev/server.js",
    "test": "npm run test:jest && npm run test:e2e",
    "test:jest": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/artofcodelabs/simplicit.git"
  },
  "keywords": [
    "simplicit",
    "framework"
  ],
  "author": "Zbigniew Humeniuk <hello@artofcode.co>",
  "license": "MIT",
  "homepage": "https://github.com/artofcodelabs/simplicit",
  "dependencies": {
    "dompurify": "^3.4.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "express": "^5.2.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-middleware": "^8.1.1"
  },
  "browserslist": [
    "defaults"
  ]
}
